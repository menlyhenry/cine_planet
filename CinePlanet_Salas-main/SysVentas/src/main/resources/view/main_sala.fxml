<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.SalaController">
    <VBox spacing="12" AnchorPane.topAnchor="15" AnchorPane.bottomAnchor="15" AnchorPane.leftAnchor="15" AnchorPane.rightAnchor="15">
        <Label text="Salas" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <HBox spacing="10">
            <TextField fx:id="txtBuscar" promptText="Buscar sala..." HBox.hgrow="ALWAYS"/>
            <Button text="Nueva sala" onAction="#nuevaSala"/>
            <Button text="Editar" onAction="#editarSala"/>
            <Button text="Eliminar" onAction="#eliminarSala"/>
        </HBox>
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS"/>
    </VBox>
</AnchorPane>
